# Инструменты разработки и проверки (ворота, CI). Версии рабочих пакетов берутся из requirements.lock (-c).
# Пересборка с хешами:
#   pip-compile --generate-hashes --no-emit-index-url --output-file=requirements-dev.lock --strip-extras requirements-dev.in
# Установка:
#   pip install --require-hashes --no-deps -r requirements.lock -r requirements-dev.lock
-c requirements.lock
